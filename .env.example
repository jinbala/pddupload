# 复制本文件为 .env 使用（.env 已被 .gitignore 忽略，不会提交）。
# 这里只是配置项；如未来需要 apikey / token 等敏感值，也放 .env，勿硬编码进代码。

# 工作目录（默认当前目录）
# PDD_AUTOMATION_HOME=

# 无头模式：true 完全后台无窗口；false 有头（默认，便于登录/验证码）
# PDD_AUTOMATION_HEADLESS=false

# 拼多多目标店铺名（留空则运行时现场输入；也可在此填入你的店铺名）
# PDD_AUTOMATION_TARGET_SHOP=

# 抖音目标店铺名（留空则运行时现场输入；也可在此填入你的店铺名）
# PDD_AUTOMATION_DOUYIN_SHOP=

# 每款之间停顿秒数（防风控，默认 15，实际随机 1~2 倍）
# PDD_AUTOMATION_DELAY_SECONDS=15

# 等待人工登录的秒数（默认 300）
# PDD_AUTOMATION_LOGIN_WAIT_SECONDS=300

# 慢动作毫秒数（调试用，默认 0）
# PDD_AUTOMATION_SLOW_MO_MS=0
